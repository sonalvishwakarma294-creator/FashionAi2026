# Frontend Environment Variables (Vite)
# ------------------------------------------------------------------
# COPY this file to ".env.local" for local development.
# For production hosting (Vercel/Netlify), set these as Environment Variables
# in your hosting platform dashboard — do NOT commit .env.local to git.
# ------------------------------------------------------------------

# ====== BACKEND API URL ======
# Development: Leave empty — Vite proxy automatically forwards /api to localhost:5001
# VITE_API_BASE_URL=

# Production: Set this to your live backend URL (no trailing slash)
# Example: VITE_API_BASE_URL=https://fashion-pro-backend.onrender.com
VITE_API_BASE_URL=
