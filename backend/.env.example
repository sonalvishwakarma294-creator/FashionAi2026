# Backend Environment Variables

# SQLite (database file is backend/fashion.db)
# No DB host/user/password needed for SQLite

# Admin credentials (one‑time seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeMe123

# JWT Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Groq AI API key
GROQ_API_KEY=gsk_your_groq_api_key_here

# CORS origins (comma‑separated). Adjust for production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5001,http://127.0.0.1:5001
