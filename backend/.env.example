# Backend Environment Variables
# ------------------------------------------------------------------
# COPY this file to ".env" and fill in your real values.
# ------------------------------------------------------------------

# ====== DATABASE (MySQL) ======
# Set USE_SQLITE=False to use the MySQL server below.
# Set USE_SQLITE=True  to use a local file (backend/fashion.db).
USE_SQLITE=False

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=fashion_ai

# ====== JWT Authentication ======
JWT_SECRET=your-super-secret-jwt-key-change-in-production-32chars-min
SECRET_KEY=dev-key-change-prod

# ====== Admin (seeded once by set_admin.py) ======
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeMe123

# ====== AI / LLM Keys ======
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====== Uploads ======
MAX_CONTENT_LENGTH=16MB
UPLOAD_FOLDER=../images/uploads

# ====== CORS (comma-separated) ======
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5001,http://127.0.0.1:5001

# ====== EMAIL / PASSWORD RECOVERY ======
# Public base URL of your React/Vite frontend — used in reset links.
FRONTEND_BASE_URL=http://localhost:5173

# SMTP delivery — set MAIL_USE_SMTP=True to actually SEND emails.
# When False (dev mode): reset links are still generated + printed to backend terminal.
MAIL_USE_SMTP=False

# --- Gmail SMTP (use an App Password, NOT your Gmail password) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16digit_gmail_app_password

# --- GreenGeeks / cPanel SMTP example ---
# MAIL_SERVER=mail.yourdomain.com
# MAIL_PORT=465
# MAIL_USE_SSL=True
# MAIL_USERNAME=no-reply@yourdomain.com
# MAIL_PASSWORD=your_email_account_password

# --- Resend / SendGrid alternative (also supported) ---
# Use same pattern but enter their SMTP host/port/user credentials.

MAIL_FROM_NAME="Fashion Pro"
MAIL_FROM_ADDRESS=no-reply@fashion.ai

# How long is the reset link valid? (minutes)
PASSWORD_RESET_TTL_MIN=30

